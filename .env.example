DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# App URL (Stripe success/cancel + email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI completer (optional — falls back to template when unset)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Stripe Checkout (optional — mock pay when unset)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend email (optional — logs to console + logs/emails.log when unset)
# RESEND_API_KEY=
# EMAIL_FROM="WorkBal <onboarding@resend.dev>"

# Worker poll interval (ms)
# WORKER_INTERVAL_MS=3000
